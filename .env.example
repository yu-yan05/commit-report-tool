# 未来キャパ予報 - 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# ============================================================
# Google サービスアカウント認証（Calendar・Sheets 共通）
# ============================================================

# サービスアカウントJSONをBase64エンコードしたもの
# 取得方法: README.md の「Google Cloud セットアップ」を参照
# Base64エンコード方法:
#   macOS/Linux: base64 -i service-account.json | tr -d '\n'
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_JSON=

# ============================================================
# Google Calendar API（メイン接続方法）
# ============================================================

# カレンダーID
#   「primary」= Googleアカウントのメインカレンダー
#   特定カレンダーを使う場合: Googleカレンダー設定の「カレンダーID」を確認
GOOGLE_CALENDAR_ID=primary

# 終日イベント1日あたりの換算時間（省略時: 8）
# 例: 終日のセミナーを6h換算にしたい場合 → 6
# ALL_DAY_HOURS=8

# ============================================================
# Google Sheets API（スプレッドシート連携版・保険用）
# ============================================================

# スプレッドシートのID
# スプレッドシートのURLから取得:
#   https://docs.google.com/spreadsheets/d/【ここがID】/edit
# SPREADSHEET_ID=

# シート名（デフォルト: Sheet1）
# 「Sheet1」以外の名前にしている場合のみ設定
# SHEET_NAME=Sheet1
